DATABASE_URL=
CONTENT_API_KEY=

# Keep Groq credentials in the API environment only. Set true after configuring the key.
GROQ_API_KEY=
GROQ_FEEDBACK_MODEL=qwen/qwen3.8-27b
GROQ_BACKUP_FEEDBACK_MODEL=openai/gpt-oss-20b
SPEECH_FEEDBACK_DAILY_REQUESTS=10
SPEECH_FEEDBACK_DAILY_TOKENS=12000
SPEECH_FEEDBACK_MAX_OUTPUT_TOKENS=700
SPEECH_FEEDBACK_TIMEOUT_MS=15000
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
SPEECH_TRANSCRIPTION_ENABLED=false
SPEECH_MAX_SECONDS=60
SPEECH_MAX_BYTES=8388608
SPEECH_PROVIDER_TIMEOUT_MS=30000
SPEECH_MAX_CONCURRENT=4
SPEECH_USER_DAILY_REQUESTS=30
SPEECH_USER_DAILY_SECONDS=1800
SPEECH_GLOBAL_MINUTE_REQUESTS=18
SPEECH_GLOBAL_HOURLY_SECONDS=6480
SPEECH_GLOBAL_DAILY_REQUESTS=1800
SPEECH_GLOBAL_DAILY_SECONDS=25920

# Optional Google OAuth (all four required to enable Continue with Google).
# Register the exact callback URL in Google Cloud for local and deployed origins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:5173/

# Transactional email (API only). Verify a Resend domain before production sends.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173

# Email verification enforcement (API only). Keep false until a production
# sending domain exists; set to 'true' once the domain is live to require
# verified emails before login.
ENFORCE_EMAIL_VERIFICATION=false

# Member chat stays disabled until guidelines approval and private Realtime setup.
CHAT_ENABLED=false
CHAT_GUIDELINES_APPROVED=false
# Confirm public channel access is OFF in the Supabase Realtime settings.
CHAT_PRIVATE_REALTIME_CONFIRMED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# API only: compatible project HS256 signing secret, never VITE_ prefixed.
SUPABASE_JWT_SECRET=
OPENAI_MODERATION_API_KEY=
CHAT_MODERATOR_API_KEY=
CHAT_JOB_API_KEY=
