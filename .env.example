DATABASE_URL=
CONTENT_API_KEY=

# Keep Groq credentials in the API environment only. Set true after configuring the key.
GROQ_API_KEY=
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
SPEECH_TRANSCRIPTION_ENABLED=false
SPEECH_MAX_SECONDS=60
SPEECH_MAX_BYTES=8388608
SPEECH_PROVIDER_TIMEOUT_MS=30000
SPEECH_MAX_CONCURRENT=4
SPEECH_USER_DAILY_REQUESTS=30
SPEECH_USER_DAILY_SECONDS=1800
SPEECH_GLOBAL_MINUTE_REQUESTS=18
SPEECH_GLOBAL_HOURLY_SECONDS=6480
SPEECH_GLOBAL_DAILY_REQUESTS=1800
SPEECH_GLOBAL_DAILY_SECONDS=25920

# Optional Google OAuth (all four required to enable Continue with Google).
# Register the exact callback URL in Google Cloud for local and deployed origins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:5173/
