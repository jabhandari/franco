{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franco.app/schemas/content.v1.schema.json",
  "title": "Franco Content Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "idempotency_key", "source", "items"],
  "properties": {
    "schema_version": { "const": "content.v1" },
    "batch_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 256 },
    "source": { "$ref": "#/$defs/source" },
    "items": { "type": "array", "minItems": 1, "maxItems": 5000, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "url", "license", "attribution"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9._:-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "url": { "type": "string", "format": "uri", "maxLength": 2000 },
        "license": { "type": "string", "minLength": 1, "maxLength": 500 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "cefr": {
      "type": "object", "additionalProperties": false, "required": ["level", "method"],
      "properties": {
        "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "method": { "enum": ["source", "human_review", "heuristic", "model", "mixed"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "string", "maxLength": 2000 }
      }
    },
    "difficulty": {
      "type": "object", "additionalProperties": false,
      "properties": { "band": { "enum": ["introductory", "basic", "intermediate", "advanced", "proficient"] }, "score": { "type": "number", "minimum": 0, "maximum": 100 }, "method": { "type": "string", "maxLength": 100 } }
    },
    "response": { "type": "object", "additionalProperties": false, "properties": { "choices": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 50 }, "text": { "type": "string", "minLength": 1, "maxLength": 5000 } } } }, "answer": {}, "accepted_answers": { "type": "array", "items": { "type": "string", "maxLength": 2000 } }, "tokens": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 100 } } } },
    "evaluation": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["exact", "choice", "normalized_text", "token_order", "rubric", "external"] }, "rubric": { "type": "string", "maxLength": 10000 }, "case_sensitive": { "type": "boolean" } } },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["external_id", "type", "cefr", "prompt", "response", "evaluation"],
      "allOf": [
        { "if": { "properties": { "type": { "const": "multiple_choice" } } }, "then": { "properties": { "response": { "required": ["choices", "answer"] }, "evaluation": { "properties": { "mode": { "const": "choice" } } } } } },
        { "if": { "properties": { "type": { "const": "word_order" } } }, "then": { "properties": { "response": { "required": ["tokens"] }, "evaluation": { "properties": { "mode": { "const": "token_order" } } } } } },
        { "if": { "properties": { "type": { "const": "listen_repeat" } } }, "then": { "properties": { "response": { "required": ["answer"] }, "evaluation": { "properties": { "mode": { "const": "normalized_text" } } } } } }
      ],
      "properties": {
        "external_id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "type": { "enum": ["multiple_choice", "cloze", "free_text", "word_order", "reading", "listening", "speaking", "vocabulary", "listen_repeat"] },
        "title": { "type": "string", "maxLength": 500 }, "prompt": { "type": "string", "minLength": 1, "maxLength": 20000 }, "instructions": { "type": "string", "maxLength": 10000 }, "context": { "type": "string", "maxLength": 100000 },
        "cefr": { "$ref": "#/$defs/cefr" }, "difficulty": { "$ref": "#/$defs/difficulty" }, "response": { "$ref": "#/$defs/response" }, "evaluation": { "$ref": "#/$defs/evaluation" },
        "concepts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }, "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "media": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "url"], "properties": { "kind": { "enum": ["audio", "image", "video", "document"] }, "url": { "type": "string", "format": "uri", "maxLength": 4000 }, "duration_seconds": { "type": "number", "minimum": 0 }, "transcript": { "type": "string", "maxLength": 100000 }, "checksum": { "type": "string", "maxLength": 128 } } } },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
