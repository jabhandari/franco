{
  // FRA-60: incremental TypeScript migration. allowJs keeps the existing
  // JS compiling while files convert to TS/TSX one ticket at a time.
  // strict flips on in the closeout ticket (FRA-68).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // FRA-62: converted .ts modules import each other with explicit '.ts'
    // specifiers (Node's type-stripping does not remap '.js' -> '.ts', and
    // the colocated .test.js files are executed by plain node). Works with
    // bundler resolution + noEmit; esbuild/Vite accept it as-is.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
